    A1("archive.list_verbose","详细查看 tar 包","Verbose tar listing","详细列出 tar 归档成员","List tar archive members verbosely","tar tvf list archive 归档 详细",CAT_ARCHIVE,RISK_NORMAL,"tar -tvf {1} | head -n 500","请输入 tar 归档路径。","Enter tar archive path.",NULL,ARG_PATH),
