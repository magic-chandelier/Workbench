    A1("archive.zip_list","查看 ZIP 内容","List ZIP archive","若安装 unzip，则列出 ZIP 内容","List ZIP contents when unzip is installed","zip unzip list archive 查看",CAT_ARCHIVE,RISK_NORMAL,"if command -v unzip >/dev/null 2>&1; then unzip -l {1}; else echo 'unzip is not installed'; fi","请输入 .zip 文件路径。","Enter .zip file path.",NULL,ARG_PATH),
    A2("archive.zip_create","创建 ZIP","Create ZIP archive","若安装 zip，则递归创建 ZIP","Create a recursive ZIP archive when zip is installed","zip create archive 创建 压缩",CAT_ARCHIVE,RISK_SENSITIVE,"if command -v zip >/dev/null 2>&1; then zip -r {1} {2}; else echo 'zip is not installed'; fi","请输入输出 .zip 路径。","Enter output .zip path.","archive.zip",ARG_PATH,"请输入要压缩的路径。","Enter path to archive.",".",ARG_PATH),
    A2("archive.zip_extract","解压 ZIP","Extract ZIP archive","若安装 unzip，则解压到指定目录","Extract a ZIP archive to a directory when unzip is installed","unzip zip extract 解压",CAT_ARCHIVE,RISK_SENSITIVE,"if command -v unzip >/dev/null 2>&1; then mkdir -p -- {2} && unzip {1} -d {2}; else echo 'unzip is not installed'; fi","请输入 .zip 文件路径。","Enter .zip file path.",NULL,ARG_PATH,"请输入目标目录。","Enter destination directory.",".",ARG_PATH),
    A1("archive.cpio_list","查看 CPIO 内容","List CPIO archive","若安装 cpio，则列出归档成员","List CPIO archive members when cpio is installed","cpio archive list 查看",CAT_ARCHIVE,RISK_NORMAL,"if command -v cpio >/dev/null 2>&1; then cpio -it < {1}; else echo 'cpio is not installed'; fi","请输入 CPIO 文件路径。","Enter CPIO file path.",NULL,ARG_PATH),
    A2("archive.cpio_extract","解压 CPIO","Extract CPIO archive","若安装 cpio，则在目标目录解压归档","Extract a CPIO archive into a target directory","cpio extract archive 解压",CAT_ARCHIVE,RISK_SENSITIVE,"if command -v cpio >/dev/null 2>&1; then src={1}; dst={2}; case \"$src\" in /*) abs=\"$src\";; *) abs=\"$(pwd)/$src\";; esac; mkdir -p -- \"$dst\" && (cd \"$dst\" && cpio -idmv < \"$abs\"); else echo 'cpio is not installed'; fi","请输入 CPIO 文件路径。","Enter CPIO file path.",NULL,ARG_PATH,"请输入目标目录。","Enter destination directory.",".",ARG_PATH),
    A1("archive.ar_list","查看 ar 静态库","List ar archive","若安装 ar，则列出 ar/静态库成员","List members of an ar/static-library archive when ar is installed","ar archive static library 静态库 查看",CAT_ARCHIVE,RISK_NORMAL,"if command -v ar >/dev/null 2>&1; then ar t {1}; else echo 'ar is not installed'; fi","请输入 .a/ar 文件路径。","Enter .a/ar archive path.",NULL,ARG_PATH),
    A2("archive.ar_extract","解压 ar 静态库","Extract ar archive","若安装 ar，则在目标目录解出全部成员","Extract all ar members into a target directory","ar extract archive 静态库 解压",CAT_ARCHIVE,RISK_SENSITIVE,"if command -v ar >/dev/null 2>&1; then src={1}; dst={2}; case \"$src\" in /*) abs=\"$src\";; *) abs=\"$(pwd)/$src\";; esac; mkdir -p -- \"$dst\" && (cd \"$dst\" && ar x \"$abs\"); else echo 'ar is not installed'; fi","请输入 .a/ar 文件路径。","Enter .a/ar archive path.",NULL,ARG_PATH,"请输入目标目录。","Enter destination directory.",".",ARG_PATH),
