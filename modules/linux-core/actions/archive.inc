    A2("archive.create_tbz2","创建 tar.bz2","Create tar.bz2","创建 bzip2 压缩 tar 归档","Create a bzip2-compressed tar archive","tar bzip2 archive 压缩",CAT_ARCHIVE,RISK_SENSITIVE,"if tar --help 2>/dev/null | grep -q -- '-j'; then tar -cjf {1} -- {2}; else echo 'tar bzip2 support unavailable'; fi","请输入输出 .tar.bz2 路径。","Enter output .tar.bz2 path.","archive.tar.bz2",ARG_PATH,"请输入要打包的路径。","Enter path to archive.",".",ARG_PATH),
