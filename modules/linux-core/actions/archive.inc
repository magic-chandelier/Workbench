    A1("archive.bunzip2","bzip2 解压文件","Bzip2 decompress file","若安装 bunzip2/bzip2，则解压 .bz2","Decompress .bz2 when bunzip2/bzip2 is installed","bunzip2 bzip2 decompress 解压",CAT_ARCHIVE,RISK_SENSITIVE,"if command -v bunzip2 >/dev/null 2>&1; then bunzip2 -- {1}; elif command -v bzip2 >/dev/null 2>&1; then bzip2 -d -- {1}; else echo 'bzip2 is not installed'; fi","请输入 .bz2 文件路径。","Enter .bz2 file path.",NULL,ARG_PATH),
