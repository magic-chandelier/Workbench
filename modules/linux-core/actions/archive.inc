    A1("archive.gunzip_keep","gzip 解压并保留压缩包","Gunzip and keep archive","使用 gzip -dk 解压并保留 .gz（若支持）","Decompress with gzip -dk while keeping the archive when supported","gzip decompress keep 保留 解压",CAT_ARCHIVE,RISK_SENSITIVE,"if gzip -h 2>&1 | grep -q -- '-k'; then gzip -dk -- {1}; else echo 'gzip -k is unavailable'; fi","请输入 .gz 文件路径。","Enter .gz file path.",NULL,ARG_PATH),
