A1("archive.list_tar","查看 tar 包内容","List tar archive","列出 tar/tar.gz/tar.xz 等归档内容","List contents of tar-based archive","tar archive list 压缩包 查看",CAT_ARCHIVE,RISK_NORMAL,"tar -tf {1} | head -n 500","请输入 tar 归档路径。","Enter tar archive path.",NULL,ARG_PATH),
