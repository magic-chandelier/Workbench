A1("perm.stat","查看权限","View permissions","查看文件/目录权限、所有者和模式","Show permissions, owner and mode","stat chmod permissions 权限",CAT_PERMISSION,RISK_NORMAL,"ls -ld -- {1}; if command -v stat >/dev/null 2>&1; then stat -- {1}; fi","请输入文件或目录路径。","Enter file or directory path.",".",ARG_PATH),
    A2("perm.chmod","修改权限","Change permissions","修改文件或目录权限模式","Change file/directory permission mode","chmod permissions mode 修改 权限",CAT_PERMISSION,RISK_SENSITIVE,"chmod {1} -- {2}","请输入权限模式，例如 644、755 或 u+x。","Enter mode, e.g. 644, 755 or u+x.","644",ARG_TEXT,"请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    A2("perm.chown","修改所有者","Change owner","修改文件或目录所有者；可能需要 root","Change owner; may require root","chown owner ownership 所有者",CAT_PERMISSION,RISK_PRIVILEGED,"chown {1} -- {2}","请输入 owner 或 owner:group。","Enter owner or owner:group.",NULL,ARG_TEXT,"请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    A2("perm.chgrp","修改所属组","Change group","修改文件或目录所属组","Change file/directory group","chgrp group 所属组",CAT_PERMISSION,RISK_SENSITIVE,"chgrp {1} -- {2}","请输入组名或 GID。","Enter group name or GID.",NULL,ARG_TEXT,"请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    F("perm.umask","当前 umask","Current umask","查看当前进程创建文件时使用的权限掩码","Show current file-creation mask","umask permission mask 权限 掩码",CAT_PERMISSION,RISK_NORMAL,"umask"),

/* Expanded generic action set */
    A1("perm.readable","检查可读权限","Check readable","检查可读权限","Check readable","test readable permission 可读 权限",CAT_PERMISSION,RISK_NORMAL,"[ -r {1} ] && echo 'yes' || echo 'no'","请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    A1("perm.writable","检查可写权限","Check writable","检查可写权限","Check writable","test writable permission 可写 权限",CAT_PERMISSION,RISK_NORMAL,"[ -w {1} ] && echo 'yes' || echo 'no'","请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    A1("perm.executable","检查可执行权限","Check executable","检查可执行权限","Check executable","test executable permission 可执行 权限",CAT_PERMISSION,RISK_NORMAL,"[ -x {1} ] && echo 'yes' || echo 'no'","请输入文件或目录路径。","Enter file or directory path.",NULL,ARG_PATH),
    A1("perm.mode_numeric","数字权限模式","Numeric permission mode","显示文件的八进制权限模式","Show file permission mode in octal","stat mode numeric chmod 权限 数字",CAT_PERMISSION,RISK_NORMAL,"if command -v stat >/dev/null 2>&1; then stat -c '%a' -- {1}; else ls -ld -- {1}; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.owner_group","所有者与用户组","Owner and group","显示文件 UID/GID 与名称","Show file owner/group IDs and names","stat owner group uid gid 所有者 用户组",CAT_PERMISSION,RISK_NORMAL,"if command -v stat >/dev/null 2>&1; then stat -c 'user=%U uid=%u group=%G gid=%g' -- {1}; else ls -ld -- {1}; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A2("perm.chmod_recursive","递归修改权限","Recursive chmod","递归修改整个目录树权限，影响范围大","Recursively change permissions for an entire tree","chmod -R recursive 权限 递归",CAT_PERMISSION,RISK_PRIVILEGED,"chmod -R {1} -- {2}","请输入权限模式。","Enter mode.","755",ARG_TEXT,"请输入目录路径。","Enter directory path.",NULL,ARG_DESTRUCTIVE_PATH),
    A2("perm.chown_recursive","递归修改所有者","Recursive chown","递归修改整个目录树所有者，通常需要 root","Recursively change ownership for a tree; usually requires root","chown -R recursive 所有者 递归",CAT_PERMISSION,RISK_PRIVILEGED,"chown -R {1} -- {2}","请输入 owner 或 owner:group。","Enter owner or owner:group.",NULL,ARG_TEXT,"请输入目录路径。","Enter directory path.",NULL,ARG_DESTRUCTIVE_PATH),
    A2("perm.chgrp_recursive","递归修改用户组","Recursive chgrp","递归修改整个目录树所属组","Recursively change group for a tree","chgrp -R recursive 用户组 递归",CAT_PERMISSION,RISK_PRIVILEGED,"chgrp -R {1} -- {2}","请输入组名或 GID。","Enter group name or GID.",NULL,ARG_TEXT,"请输入目录路径。","Enter directory path.",NULL,ARG_DESTRUCTIVE_PATH),
    A1("perm.acl_get","查看 ACL","View ACL","若安装 getfacl，则查看访问控制列表","View access-control list when getfacl is installed","getfacl acl permission ACL 权限",CAT_PERMISSION,RISK_NORMAL,"if command -v getfacl >/dev/null 2>&1; then getfacl -- {1}; else echo 'getfacl is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A3("perm.acl_set_user","设置用户 ACL","Set user ACL","若安装 setfacl，则为用户设置 ACL 条目","Set a user ACL entry when setfacl is installed","setfacl acl user permission ACL 用户",CAT_PERMISSION,RISK_SENSITIVE,"if command -v setfacl >/dev/null 2>&1; then setfacl -m u:{1}:{2} -- {3}; else echo 'setfacl is not installed'; fi","请输入用户名。","Enter user name.",NULL,ARG_TEXT,"请输入权限，如 rwx 或 r--。","Enter permissions, e.g. rwx or r--.","r--",ARG_TEXT,"请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.acl_remove","删除扩展 ACL","Remove extended ACL","若安装 setfacl，则移除扩展 ACL","Remove extended ACL entries when setfacl is installed","setfacl -b acl remove 删除 ACL",CAT_PERMISSION,RISK_SENSITIVE,"if command -v setfacl >/dev/null 2>&1; then setfacl -b -- {1}; else echo 'setfacl is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.xattr_get","查看扩展属性","View extended attributes","若安装 getfattr，则查看扩展属性","View extended attributes when getfattr is installed","getfattr xattr extended attribute 扩展属性",CAT_PERMISSION,RISK_NORMAL,"if command -v getfattr >/dev/null 2>&1; then getfattr -d -- {1}; else echo 'getfattr is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A3("perm.xattr_set","设置扩展属性","Set extended attribute","若安装 setfattr，则设置一个扩展属性","Set one extended attribute when setfattr is installed","setfattr xattr extended attribute 设置 扩展属性",CAT_PERMISSION,RISK_SENSITIVE,"if command -v setfattr >/dev/null 2>&1; then setfattr -n {1} -v {2} -- {3}; else echo 'setfattr is not installed'; fi","请输入属性名，如 user.note。","Enter attribute name, e.g. user.note.","user.note",ARG_TEXT,"请输入属性值。","Enter attribute value.","value",ARG_TEXT,"请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.lsattr","查看文件属性标志","View inode attribute flags","若安装 lsattr，则查看 ext 文件属性标志","View inode attribute flags when lsattr is installed","lsattr chattr immutable 文件 属性",CAT_PERMISSION,RISK_NORMAL,"if command -v lsattr >/dev/null 2>&1; then lsattr -d -- {1}; else echo 'lsattr is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.immutable_on","设置不可变标志","Set immutable flag","若安装 chattr，则设置 +i；通常需要高权限","Set +i with chattr; often requires privilege","chattr +i immutable 不可变",CAT_PERMISSION,RISK_PRIVILEGED,"if command -v chattr >/dev/null 2>&1; then chattr +i -- {1}; else echo 'chattr is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
    A1("perm.immutable_off","清除不可变标志","Clear immutable flag","若安装 chattr，则清除 -i；通常需要高权限","Clear -i with chattr; often requires privilege","chattr -i immutable 不可变",CAT_PERMISSION,RISK_PRIVILEGED,"if command -v chattr >/dev/null 2>&1; then chattr -i -- {1}; else echo 'chattr is not installed'; fi","请输入路径。","Enter path.",NULL,ARG_PATH),
