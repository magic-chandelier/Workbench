    A1("process.find","按名称查进程","Find process by name","按进程名搜索 PID 和命令行","Find PIDs/commands by process name","pgrep process name 查找 进程",CAT_PROCESS,RISK_NORMAL,"if command -v pgrep >/dev/null 2>&1; then pgrep -af -- {1}; else ps aux | grep -F -- {1} | grep -v grep; fi","请输入进程名称关键词。","Enter process name text.",NULL,ARG_TEXT),
