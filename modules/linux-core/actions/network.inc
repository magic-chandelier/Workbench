    A1("network.link_up","启用网卡","Bring interface up","使用 ip 把指定网卡设为 UP；通常需要 root","Bring an interface UP with ip; usually requires root","ip link set up 网卡 启用",CAT_NETWORK,RISK_PRIVILEGED,"if command -v ip >/dev/null 2>&1; then ip link set dev {1} up; else echo 'ip is not installed'; fi","请输入网卡名称。","Enter interface name.","eth0",ARG_TEXT),
