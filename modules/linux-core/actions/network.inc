    A1("network.dns_a","DNS A 查询","DNS A lookup","查询域名的 A 记录","Query A records for a name","dig nslookup dns A 查询",CAT_NETWORK,RISK_SENSITIVE,"n={1}; if command -v dig >/dev/null 2>&1; then dig +short A \"$n\"; elif command -v nslookup >/dev/null 2>&1; then nslookup -type=A \"$n\"; elif [ 'A' = A ] && command -v getent >/dev/null 2>&1; then getent ahostsv4 \"$n\"; else echo 'dig/nslookup not installed'; fi","请输入域名。","Enter domain name.","example.com",ARG_TEXT),
